{
  "$schema": "https://swc.rs/schema.json",
  "sourceMaps": true,
  "exclude": ["\\.test\\.ts$"],
  "module": { "type": "es6" },
  "jsc": {
    "target": "es2023",
    "parser": { "syntax": "typescript", "decorators": true, "dynamicImport": true },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "keepClassNames": true,
    "experimental": { "keepImportAttributes": true }
  },
  "minify": false
}
