{
  "name": "@sanchay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start -b swc -w",
    "build": "nest build -b swc",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db-check.ts",
    "db:migrate": "nest build -b swc && node dist/cli/migrate.js",
    "openapi": "node scripts/openapi.ts",
    "ops:invite": "nest build -b swc && node dist/cli/ops-invite.js",
    "ops:catalogue:seed": "nest build -b swc && node dist/cli/ops-catalogue-seed.js",
    "ops:nav-backfill": "nest build -b swc && node dist/cli/ops-nav-backfill.js",
    "ops:nav-release": "nest build -b swc && node dist/cli/ops-nav-release.js"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-fastify": "catalog:",
    "@nestjs/throttler": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/nest": "catalog:",
    "@orpc/server": "catalog:",
    "@sanchay/contract": "workspace:*",
    "@sanchay/domain": "workspace:*",
    "@sanchay/money": "workspace:*",
    "drizzle-orm": "catalog:",
    "fastify": "catalog:",
    "lossless-json": "catalog:",
    "nestjs-cls": "catalog:",
    "nestjs-pino": "catalog:",
    "pg": "catalog:",
    "pg-boss": "catalog:",
    "pino": "catalog:",
    "pino-http": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "undici": "catalog:",
    "uuid": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/openapi-client": "catalog:",
    "@sanchay/config": "workspace:*",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "drizzle-kit": "catalog:",
    "light-my-request": "catalog:",
    "typescript": "catalog:",
    "unplugin-swc": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
