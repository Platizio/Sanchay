# Copy to apps/api/.env (git-ignored). Variables already set in the process environment win over this file.
# Local mode only (H-8). dev/staging/prod get variables from ECS + Secrets Manager (sanchay/{env}/keyring).
SANCHAY_APP_ENV=local
SANCHAY_APP_ROLE=api
PORT=3000
SANCHAY_LOG_LEVEL=debug
DATABASE_URL=postgres://sanchay:sanchay_local_only@localhost:55432/sanchay
SANCHAY_APP_ORIGIN=http://localhost:3001
# socket locally; must be alb outside local/test (boot invariant 6)
SANCHAY_CLIENT_IP_SOURCE=socket
# local keyring (32 random bytes, base64 each); refused outside local/test (boot invariant 2)
SANCHAY_KEY_SERVICE=local
SANCHAY_LOCAL_PII_KEY=
SANCHAY_LOCAL_BIDX_KEY=
SANCHAY_OTP_PEPPER=
SANCHAY_AUTH_TOKEN_KEY=
# Mailpit is the only OTP channel in local dev (H-20); capture/mailpit are refused in staging/prod (boot invariant 1)
SANCHAY_PROVIDER_MODE_SMS=mailpit
SANCHAY_PROVIDER_MODE_EMAIL=mailpit
SANCHAY_MAILPIT_URL=http://localhost:8025
SANCHAY_THROTTLE_PER_MINUTE=120
# Local only: all web traffic reaches the API from 127.0.0.1 through the Next rewrite. Must be 20 outside local/test (boot invariant 5).
SANCHAY_OTP_PER_IP_PER_HOUR=1000
# Android SMS Retriever hash (penultimate SMS line, H-6); set it only when testing with a Play-signed build.
# SANCHAY_SMS_RETRIEVER_HASH=
# msg91/ses are staging/prod only (boot invariants 1, 11, 12); local dev stays on mailpit.
# SANCHAY_MSG91_CREDENTIALS_JSON={"authKey":"","senderId":"","peId":"","templateIds":{"LOGIN":"","CONSENT":"","CONSENT_UNITS":"","ATTEST":""}}
# SANCHAY_SES_FROM=noreply@sanchay.in
# invite-only pilot gate (D7). The schema default is true; local dev and the web e2e sign up fresh
# numbers, so the local example turns it off. false is refused in prod until P2 (boot invariant 10).
SANCHAY_PILOT_INVITE_ONLY=false
# HMAC verification for POST /api/v1/webhooks/fp; the api role needs it outside local/test (boot invariant 13)
SANCHAY_FP_WEBHOOK_AUTH=hmac
# SANCHAY_FP_WEBHOOK_SECRET=
SANCHAY_API_ORIGIN=http://localhost:3000
# The platform's AMFI ARN stamped on every order (E20). Clearly fake locally; the real value comes from the deploy env.
SANCHAY_PLATFORM_ARN=ARN-000000
