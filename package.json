{
  "name": "sanchay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen:states": "pnpm --filter=@sanchay/domain build && node scripts/gen-states.ts",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "test:int": "turbo run test:int",
    "db:up": "docker compose up -d postgres mailpit",
    "db:migrate": "pnpm --filter=@sanchay/api db:migrate",
    "e2e:web": "turbo run e2e:web --filter=@sanchay/web",
    "check-brand": "node scripts/check-brand.ts",
    "ops:legal:seed": "pnpm --filter=@sanchay/api build && pnpm --filter=@sanchay/api exec node dist/cli/ops-legal-seed.js",
    "ops:invite": "pnpm --filter=@sanchay/api ops:invite",
    "ops:catalogue:seed": "pnpm --filter=@sanchay/api ops:catalogue:seed",
    "ops:nav-backfill": "pnpm --filter=@sanchay/api ops:nav-backfill",
    "ops:nav-release": "pnpm --filter=@sanchay/api ops:nav-release",
    "ops:facts:import": "pnpm --filter=@sanchay/api ops:facts:import"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sanchay/config": "workspace:*",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
