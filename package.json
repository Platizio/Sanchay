{
  "name": "sanchay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test",
    "test:int": "turbo run test:int",
    "db:up": "docker compose up -d postgres mailpit"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@sanchay/config": "workspace:*",
    "lefthook": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
